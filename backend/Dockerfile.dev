# ── Dev image: TypeScript runs via tsx (no compile step, faster CI) ──
# NODE_ENV=development, all dev dependencies included, source maps available
FROM node:20-alpine
WORKDIR /app

ENV NODE_ENV=development

COPY package*.json ./
RUN npm install

COPY tsconfig.json ./
COPY src ./src

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:5000/api/health || exit 1

CMD ["npx", "tsx", "src/server.ts"]
