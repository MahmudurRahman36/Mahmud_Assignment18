# ==============================================================================
# Server
# ==============================================================================
PORT=5000
# One or more allowed frontend origins, comma-separated (no spaces needed —
# they're trimmed — and trailing slashes are stripped automatically).
# Used for both Express CORS and Socket.IO CORS.
CLIENT_URL=http://localhost:5173,https://your-frontend.onrender.com
NODE_ENV=development

# ==============================================================================
# Chat UI configuration (served via GET /api/config/chat)
# The frontend must NOT hard-code these values.
#
# NOTE: hex color values MUST be quoted. Without quotes, dotenv treats the
# leading "#" as the start of a comment and the value is parsed as empty.
# ==============================================================================
CHAT_PRIMARY_COLOR="#2563EB"
CHAT_SECONDARY_COLOR="#EFF6FF"
CHAT_USER_MESSAGE_COLOR="#2563EB"
CHAT_AGENT_MESSAGE_COLOR="#F3F4F6"
CHAT_TEXT_COLOR="#111827"
CHAT_BACKGROUND_COLOR="#FFFFFF"
CHAT_HEADER_COLOR="#2563EB"
CHAT_HEADER_TEXT_COLOR="#FFFFFF"
CHAT_INPUT_BACKGROUND_COLOR="#FFFFFF"
CHAT_BORDER_RADIUS=12px
